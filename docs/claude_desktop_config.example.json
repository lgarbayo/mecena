{
  "mcpServers": {
    "mecena": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mecena.fly.dev/api/mcp", "--header", "Authorization:${MECENA_AUTH}"],
      "env": {
        "MECENA_AUTH": "Bearer mcn_PEGA_AQUI_TU_TOKEN"
      }
    },
    "mecena-local": {
      "command": "npx",
      "args": [
        "--prefix",
        "/ABSOLUTE/PATH/TO/mecena",
        "tsx",
        "--tsconfig",
        "/ABSOLUTE/PATH/TO/mecena/tsconfig.json",
        "/ABSOLUTE/PATH/TO/mecena/src/mcp/server.ts"
      ],
      "env": {
        "MECENA_PUBLIC_URL": "http://localhost:3000",
        "MECENA_USER_EMAIL": "tu@email.com"
      }
    }
  }
}
