# --- Anthropic (leave empty to run every AI call on deterministic mocks) ---
ANTHROPIC_API_KEY=
# 1 forces AI mocks even when a key is present (tests always force it)
MECENA_AI_MOCK=
MECENA_MODEL_FAST=claude-sonnet-5-5
MECENA_MODEL_SMART=claude-opus-5-5

# --- RevenueCat (Web Billing; use the SANDBOX public key, starts with rcb_sb_) ---
NEXT_PUBLIC_REVENUECAT_API_KEY=
# Optional: secret key (sk_...) so the server can verify entitlements via REST v1
REVENUECAT_SECRET_API_KEY=
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
NEXT_PUBLIC_REVENUECAT_OFFERING_ID=default
# 1 forces the mock purchases adapter even when a key is present
NEXT_PUBLIC_PURCHASES_MOCK=

# --- App ---
# Where the JSON database, uploads and PDF exports live (gitignored)
MECENA_DATA_DIR=./data/runtime
# Base URL used in links the MCP server returns (use your tunnel URL on demo day)
MECENA_PUBLIC_URL=http://localhost:3000

# --- Accounts ---
# Optional invite code. When set, creating an account (/entrar -> "Crear cuenta") requires this code, so strangers
# cannot sign up and spend the owner's ANTHROPIC_API_KEY. Leave empty for open sign-up.
MECENA_SIGNUP_CODE=
# MCP server only (npm run mcp): the email of the Mecena account the MCP tools act as. Required by the MCP server.
MECENA_USER_EMAIL=

# --- BDNS (Base de Datos Nacional de Subvenciones) ingest spike ---
BDNS_API_BASE=https://www.infosubvenciones.es/bdnstrans/api
# Live BDNS catalogue: per-profile background searches and the daily in-process refresh, which write
# <MECENA_DATA_DIR>/calls/bdns-live.json. On when ANTHROPIC_API_KEY is set; 0 = off (tests), 1 = on even with AI mocks.
MECENA_CALLS_LIVE=

# --- Data locations (defaults are fine; tests override them) ---
MECENA_CALLS_DIR=./data/calls
MECENA_SEED_FILE=./data/demo/seed.json
