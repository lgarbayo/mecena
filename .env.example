# --- Anthropic (leave empty to run every AI call on deterministic mocks) ---
ANTHROPIC_API_KEY=
# 1 forces AI mocks even when a key is present (tests always force it)
MECENA_AI_MOCK=
MECENA_MODEL_FAST=claude-sonnet-5-5
MECENA_MODEL_SMART=claude-opus-5-5
# Model for each live onboarding turn (voice/text -> profile + dossier). Latency-bound: Haiku is the fastest measured
# (1.8 s p50 / 2.9 s p95). Set claude-sonnet-5-5 to fall back to the fast tier's model.
MECENA_MODEL_ONBOARDING=claude-haiku-5-5
# Simulated jury latency knobs (defaults: judges on the smart model at medium effort, revision at medium effort).
# MECENA_JURY_TIER=fast moves the 3 judges to the fast model if the 61 -> 84 beat is too slow in rehearsal.
MECENA_JURY_TIER=
# Free layout ("maquetación libre"): the model composes the dossier page by page (no templates; without a key the artist
# keeps the template design). Default claude-sonnet-5-5 with reasoning on; claude-opus-5-5 is accepted.
MECENA_MODEL_LAYOUT=
# Proposals per batch (default 2, max 4). Each costs one reasoning model call, plus one for the art direction.
MECENA_LAYOUT_COUNT=
# 0 = the free layout is not on by default for profiles that never had a template design saved.
MECENA_FREE_LAYOUT_DEFAULT=
MECENA_JURY_EFFORT=
MECENA_REVISE_EFFORT=

# --- RevenueCat (Web Billing; use the SANDBOX public key, starts with rcb_sb_) ---
NEXT_PUBLIC_REVENUECAT_API_KEY=
# Secret key (sk_...): the server verifies every purchase with RevenueCat REST v1. REQUIRED wherever real purchases
# happen (Fly: `fly secrets set REVENUECAT_SECRET_API_KEY=sk_...`). Without it the server refuses purchase claims,
# except in the explicit mock mode below outside production.
REVENUECAT_SECRET_API_KEY=
NEXT_PUBLIC_REVENUECAT_ENTITLEMENT_ID=mecena_pro
NEXT_PUBLIC_REVENUECAT_OFFERING_ID=default
# 1 = mock purchases ("Modo prueba", nothing charged): forces the mock adapter even when a key is present, and lets
# the server grant simulated purchases when NODE_ENV is not production (local dev, offline demo with `npm run dev`).
NEXT_PUBLIC_PURCHASES_MOCK=1

# --- App ---
# Where the JSON database, uploads and PDF exports live (gitignored)
MECENA_DATA_DIR=./data/runtime
# Base URL used in links the MCP server returns (use your tunnel URL on demo day)
MECENA_PUBLIC_URL=http://localhost:3000

# --- Accounts ---
# Invite code. When set, creating an account (/entrar -> "Crear cuenta") requires this code, so strangers cannot sign up
# and spend the owner's ANTHROPIC_API_KEY. Set in production (Fly secret). Leave empty locally for open sign-up.
# Codes with a cap, expiry, cohort and gifted credits live in the database: `npm run invite -- create 1HACK --uses 50 --credits 1`.
MECENA_SIGNUP_CODE=
# "1" = open sign-up: anyone can create an account; invite codes (env or db) become optional but still tag the cohort and
# gift credits. AI spend stays bounded by the per-user limits and MECENA_AI_DAILY_CAP.
MECENA_SIGNUP_OPEN=
# Global ceiling of Claude requests per day (Europe/Madrid), every user and background job together, on top of the
# per-user limits of each AI route. Default 1500; 0 = no ceiling.
MECENA_AI_DAILY_CAP=
# MCP server only (npm run mcp): the email of the Mecena account the MCP tools act as. Required by the MCP server.
MECENA_USER_EMAIL=
# Stage accounts (comma separated). Only these may load the «Artista Pro con solicitud» scenario from /demo when
# purchases are real (RevenueCat keys set): it grants a demo Pro marked activeProductId "demo" on the server.
# On Fly: fly secrets set DEMO_EMAILS="demo@…,reserva@…"
DEMO_EMAILS=

# --- BDNS (Base de Datos Nacional de Subvenciones) ingest spike ---
BDNS_API_BASE=https://www.infosubvenciones.es/bdnstrans/api
# Live BDNS catalogue: per-profile background searches and the daily in-process refresh, which write
# <MECENA_DATA_DIR>/calls/bdns-live.json. On when ANTHROPIC_API_KEY is set; 0 = off (tests), 1 = on even with AI mocks.
MECENA_CALLS_LIVE=

# --- Data locations (defaults are fine; tests override them) ---
MECENA_CALLS_DIR=./data/calls
MECENA_SEED_FILE=./data/demo/seed.json
